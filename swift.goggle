! サイトのコンテンツによる比重
! $incontent は未実装のためコメントアウトしてある
!
! 言語本体
! *swift*$boost=6,incontent
! *objc*$boost=2,incontent
! *objective-c*$boost=2,incontent
! *pkl*$boost=1,incontent
!
! UI フレームワーク
! *swiftui*$boost=5,incontent
! *uikit*$boost=8,incontent
! *appkit*$boost=8,incontent
! *swiftwin32*$boost=5,incontent
! *swift-win32*$boost=5,incontent
! *swiftwin32ui*$boost=5,incontent
!
! グラフィックスと機械学習
! *metalkit*$boost=5,incontent
! *msl*$boost=5,incontent
! *coreml*$boost=5,incontent
! *core ml*$boost=5,incontent
! *createml*$boost=5,incontent
! *create ml*$boost=5,incontent
! *mlx*$boost=5,incontent
!
! ツールとライブラリ
! *xcode*$boost=3,incontent
! *swiftplaygrounds*$boost=5,incontent
! *swift playgrounds*$boost=5,incontent
! *vapor*$boost=5,incontent
! *swift-argument-parser*$boost=5,incontent