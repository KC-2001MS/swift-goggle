! name: Swift
! description: Brave Search Goggle for easy searching of Swift language documentation, libraries, etc.
! public: true
! author: Keisuke Chinone
! avatar: #FF3D28
! homepage: https://github.com/KC-2001MS/swift-goggle
! issues: https://github.com/KC-2001MS/swift-goggle/issues
! license: MIT

! 既定のアクションを変更し、どの命令にもマッチしない結果を除外する
$discard

! フレームワークとプログラミング言語に対しての比重
*swiftui*$boost=8
*uikit*$boost=7
*appkit*$boost=7
*swiftwinui*$boost=6
*swift-winui*$boost=6
*swiftwin32*$boost=6
*swift-win32*$boost=6
*metalkit*$boost=5
*coreml*$boost=5
*createml*$boost=5
*swift-argument-parser*$boost=5
*xcode*$boost=3
*objc*$boost=2
*objectivec*$boost=2
*objective-c*$boost=2
*windows-app-sdk*$discard

! サイトに対する比重
$boost=6,site=swift.org
$boost=6,site=www.swift.org
$boost=6,site=forums.swift.org
$boost=6,site=docs.swift.org
$boost=6,site=swiftpackageindex.com
$boost=6,site=swift-ast-explorer.com
$boost=6,site=hackingwithswift.com
$boost=6,site=www.hackingwithswift.com
$boost=6,site=swiftwasm.org
$boost=6,site=vapor.codes
$boost=5,site=tryswift.jp
$boost=4,site=developer.apple.com
$boost=4,site=iosdc.jp
$boost=1,site=pkl-lang.org
wikipedia.org^$discard
$discard,site=support.google.com
$discard,site=toolbar.google.com
$discard,site=developer.android.com
$discard,site=play.google.com
$discard,site=support.apple.com
$discard,site=workspace.google.com
$discard,site=discussions.apple.com
$discard,site=support.microsoft.com
$discard,site=learn.microsoft.com
$discard,site=getuikit.com
$discard,site=swift.com
$discard,site=taylorswift.com
$discard,site=www.taylorswift.com

! サイトのパスによる比重
/documentation/$boost=4,site=developer.apple.com
/documentation/$boost=4,site=github.com
/tutorials/$boost=2,site=developer.apple.com
/tutorials/$boost=2,site=github.com
/forums/$boost=1,site=developer.apple.com
/design/$boost=1,site=developer.apple.com
/@AppleDeveloper/$boost=6,site=youtube.com
/@AppleDeveloper/$boost=6,site=www.youtube.com

